# ==========================================
# Application Environment Configuration
# ==========================================

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Configuration
PORT=5000
HOST=0.0.0.0

# MongoDB Root Credentials (Used by official mongo image)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=supersecretpassword
MONGO_INITDB_DATABASE=tasks_db

# MongoDB Connection URI (Used by backend)
# When running with Docker Compose, host is 'mongodb' (service name)
MONGODB_URI=mongodb://admin:supersecretpassword@mongodb:27017/tasks_db?authSource=admin

# Nginx External Host Port
NGINX_PORT=80

